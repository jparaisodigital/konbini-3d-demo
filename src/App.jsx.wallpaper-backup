export default function App() {
  const [targetProduct, setTargetProduct] = useState(null)
  const [inspectedProduct, setInspectedProduct] = useState(null)

  useEffect(() => {
    const handleInspect = (event) => {
      if (event.code === 'KeyE' && targetProduct && !inspectedProduct) {
        event.preventDefault()
        setInspectedProduct(targetProduct)
        document.exitPointerLock?.()
      }
    }

    window.addEventListener('keydown', handleInspect)
    return () => window.removeEventListener('keydown', handleInspect)
  }, [targetProduct, inspectedProduct])
  return (
    <div style={{ width: '100vw', height: '100vh' }}>
      <Canvas shadows camera={{ position: [12, 12, 18], fov: 55 }}>
        <color attach="background" args={['#f0ebe2']} />
        <ambientLight color="#fff0dc" intensity={1.2} />
        <hemisphereLight args={['#fff7e8', '#a7a099', 1.0]} />
        <directionalLight
          position={[2, 9, 4]}
          color="#fff1dc"
          intensity={2}
          castShadow
          shadow-mapSize={[2048, 2048]}
          shadow-camera-left={-12}
          shadow-camera-right={12}
          shadow-camera-top={12}
          shadow-camera-bottom={-12}
        />
        <Supermarket />
        <FirstPersonController />
        <ProductDetector onTargetChange={setTargetProduct} />
      </Canvas>
      <div
        aria-label="Aim crosshair"
        style={{
          position: 'fixed',
          top: '50%',
          left: '50%',
          transform: 'translate(-50%, -50%)',
          pointerEvents: 'none',
          userSelect: 'none',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
        }}
      >
        {targetProduct ? (
          <svg
            width="23"
            height="23"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#ffffff"
            strokeWidth="1.8"
            strokeLinecap="round"
            strokeLinejoin="round"
            style={{ filter: 'drop-shadow(0 1px 3px rgba(0,0,0,0.7))' }}
          >
            <path d="M8 13V6a2 2 0 0 1 4 0v6" />
            <path d="M12 11a2 2 0 0 1 4 0v1" />
            <path d="M16 12a2 2 0 0 1 4 0v4a6 6 0 0 1-6 6h-2a6 6 0 0 1-5-2.7l-3-4.5a2 2 0 0 1 3.1-2.5L8 14" />
          </svg>
        ) : (
          <span style={{
            width: '5px',
            height: '5px',
            borderRadius: '50%',
            background: '#ffffff',
            boxShadow: '0 1px 3px rgba(0,0,0,0.7)',
          }} />
        )}
      </div>
      {targetProduct && !inspectedProduct && (
        <div
          style={{
            position: 'fixed',
            top: '55%',
            left: '50%',
            transform: 'translateX(-50%)',
            padding: '10px 16px',
            background: 'rgba(0, 0, 0, 0.75)',
            color: '#fff',
            fontSize: '13px',
            borderRadius: '6px',
            pointerEvents: 'none',
          }}
        >
          Press E to inspect
        </div>
      )}
      <ProductInspection
        product={inspectedProduct}
        onClose={() => setInspectedProduct(null)}
      />
    </div>
  )
}



















